{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pc-technosystem-servicios",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/logout"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pc-technosystem-db",
      "database_id": "5de03fdf-ec9b-4c63-803b-8f396dc4a78c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "pc-technosystem-evidencias"
    }
  ]
}
